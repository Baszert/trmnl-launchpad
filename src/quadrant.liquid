{% if has_launch %}
<div class="layout launchpad-plugin layout--col layout--left h--full gap--small lg:gap lg:p--4" id="launchpadApp">

  <div class="flex flex--col flex--left w--full">
    <div class="flex flex--center-y stretch">
      <div class="value--xxsmall flex flex--center"><i class="hgi hgi-stroke hgi-calendar-01 value--small"></i>  {{ launch_date }} &mdash; {{ launch_time_display }}</div>
    </div>
    <div>
      <div class="bg--gray-75 p--2 md:pb--1 px--3 rounded--full text-stroke label">
        {{ launch_status }}
      </div>
      <div class="bg--black text--white p--2 md:pb--1 px--3 rounded--full label">
        {{ countdown_label }}
      </div>
    </div>
  </div>

  <div class="stretch border--h-5 pb--4">
    <div class="flex flex--col flex--left flex--top h--full">
      <div data-value-fit="true" class="title bold" data-clamp="1">{{ launch_name }} </div>
      <div class="label--small">By {{ provider_name}}</div>
      <div class="label--small text--gray-30 body-text hidden lg:block" data-clamp="3">
        {{ mission_description }}
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2 gap--none lg:hidden">
    {% render "dataPointXSmall", title: "Rocket name", value: rocket_name, icon: "hgi-rocket-01" %}
    {% render "dataPointXSmall", title: "Launchpad", value: pad_name, icon: "hgi-rocket-02" %}
    {% render "dataPointXSmall", title: "Destination", value: mission_orbit, icon: "hgi-saturn-02" %}
    {% render "dataPointXSmall", title: "Location", value: location_name, icon: "hgi-pin-location-03" %}
  </div>
    <div class="hidden lg:grid lg:grid--cols-2 lg:gap">
    {% render "dataPointSmall", title: "Rocket", value: rocket_name, icon: "hgi-rocket-01" %}
    {% render "dataPointSmall", title: "Launchpad", value: pad_name, icon: "hgi-rocket-02" %}
    {% render "dataPointSmall", title: "Destination", value: mission_orbit, icon: "hgi-saturn-02" %}
    {% render "dataPointSmall", title: "Location", value: location_name, icon: "hgi-pin-location-03" %}
  </div>
</div>
{% endif %}
